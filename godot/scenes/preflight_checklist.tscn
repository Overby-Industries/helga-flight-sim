[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/preflight_checklist.gd" id="1"]

[node name="PreflightChecklist" type="CanvasLayer"]
script = ExtResource("1")

[node name="Root" type="Control" parent="."]
unique_name_in_owner = true
anchor_left = 0.5
anchor_right = 0.5
offset_left = -220.0
offset_top = 16.0
offset_right = 220.0
offset_bottom = 210.0
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Root/Panel"]
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="Root/Panel/VBox"]
text = "PREFLIGHT CHECKLIST"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 18

[node name="Item1Label" type="Label" parent="Root/Panel/VBox"]
unique_name_in_owner = true
text = "[ ] 1. FC-A primary flight computer"

[node name="Item2Label" type="Label" parent="Root/Panel/VBox"]
unique_name_in_owner = true
text = "[ ] 2. FC-B backup flight computer"

[node name="Item3Label" type="Label" parent="Root/Panel/VBox"]
unique_name_in_owner = true
text = "[ ] 3. FC-C backup flight computer"

[node name="Item4Label" type="Label" parent="Root/Panel/VBox"]
unique_name_in_owner = true
text = "[ ] 4. Sensor fusion"

[node name="Item5Label" type="Label" parent="Root/Panel/VBox"]
unique_name_in_owner = true
text = "[ ] 5. Propulsion controller status"

[node name="StatusLabel" type="Label" parent="Root/Panel/VBox"]
unique_name_in_owner = true
text = "Press 1-5 to complete the preflight checklist."
autowrap_mode = 2
theme_override_font_sizes/font_size = 14
